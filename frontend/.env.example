# API qua Vite proxy khi chay local. Production can reverse proxy /api ve backend.
VITE_API_URL=/api

# Firebase Web / FCM - public browser configuration only
# Firebase Console > Project settings > General > Your apps > Web app: apiKey.
VITE_FIREBASE_API_KEY=""
# Web app config: authDomain.
VITE_FIREBASE_AUTH_DOMAIN=""
# Web app config: projectId. Must match FIREBASE_PROJECT_ID in backend.
VITE_FIREBASE_PROJECT_ID=""
# Web app config: storageBucket. Copy exactly as provided by Firebase.
VITE_FIREBASE_STORAGE_BUCKET=""
# Web app config: messagingSenderId.
VITE_FIREBASE_MESSAGING_SENDER_ID=""
# Web app config: appId.
VITE_FIREBASE_APP_ID=""
# Project settings > Cloud Messaging > Web Push certificates: PUBLIC key only.
VITE_FIREBASE_VAPID_KEY=""
