POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="backend"
POSTGRES_PORT="15432"
DATABASE_URL="postgresql://postgres:postgres@localhost:15432/backend?schema=public"
REDIS_PORT="16379"
REDIS_URL="redis://localhost:16379"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
# Comma-separated frontend origins, without trailing slashes.
CORS_ORIGINS="http://localhost:5173,http://localhost:3001,http://127.0.0.1:5173"

# Service URLs (backend only; change when deploying)
# Website used for links in transactional emails.
APP_FRONTEND_URL="http://localhost:5173"
# Public backend origin when deployed.
APP_BACKEND_URL="http://localhost:3000"

# VNPay - sandbox first
# Terminal ID / vnp_TmnCode provided by VNPay.
VNPAY_TMN_CODE=""
# Secret key / vnp_HashSecret provided by VNPay.
VNPAY_HASH_SECRET=""
# Sandbox payment endpoint. Use production endpoint only with live credentials.
VNPAY_PAYMENT_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
# Frontend VNPay result page. Change origin when deploying.
VNPAY_RETURN_URL="http://localhost:5173/thanh-toan/vnpay/ket-qua"
# Register PUBLIC_HTTPS_BACKEND/api/shop/payments/vnpay/ipn with VNPay; localhost is unreachable by VNPay.
VNPAY_IPN_URL=""

# SendGrid - transactional order emails
# API key with Mail Send permission.
SENDGRID_API_KEY=""
# Sender email verified in SendGrid; not the customer email.
SENDGRID_FROM_EMAIL=""
# Display name of sender.
SENDGRID_FROM_NAME="Gốm Cho Em"
# Optional support address for customer replies.
SENDGRID_REPLY_TO_EMAIL=""
# Dynamic Template ID starting with d-; activate its version in SendGrid.
SENDGRID_ORDER_TEMPLATE_ID=""
# Public HTTPS URL of the shop logo; Cloudinary delivery URL can be used.
SENDGRID_LOGO_URL=""

# Cloudinary - signed image and video uploads through backend
# Cloud name from Cloudinary console.
CLOUDINARY_CLOUD_NAME=""
# API key from Cloudinary console.
CLOUDINARY_API_KEY=""
# API secret; backend only.
CLOUDINARY_API_SECRET=""
# Base folder for shop media.
CLOUDINARY_UPLOAD_FOLDER="gomchoem"

# QueryDR endpoint; use matching live endpoint with production credentials.
VNPAY_API_URL="https://sandbox.vnpayment.vn/merchant_webapi/api/transaction"

# Add missing demo catalog on startup; existing products and stock stay unchanged. Set false for production.
DB_SEED_ON_START="true"

# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY="false"

# Firebase Admin / FCM HTTP v1 - server credentials only
# Service account JSON: project_id. Same Firebase project as frontend.
FIREBASE_PROJECT_ID=""
# Service account JSON: client_email. Backend only.
FIREBASE_CLIENT_EMAIL=""
# Service account JSON: private_key. Keep BEGIN/END PRIVATE KEY and literal \n inside double quotes. Backend only; never VITE_ or NEXT_PUBLIC_.
FIREBASE_PRIVATE_KEY=""
