{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/run-server.ts dev",
    "build": "prisma generate && next build",
    "start": "tsx scripts/run-server.ts start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:check": "tsx scripts/check-connections.ts",
    "postinstall": "prisma generate",
    "db:seed": "tsx scripts/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "worker": "tsx scripts/reservation-worker.ts",
    "test:integration": "tsx scripts/test-integration.ts",
    "setup:local": "tsx scripts/setup-local.ts",
    "predev": "npm run db:init",
    "prestart": "tsx scripts/bootstrap.ts --production",
    "db:init": "tsx scripts/bootstrap.ts",
    "integrations:check": "tsx scripts/check-integrations.ts"
  },
  "dependencies": {
    "@next/env": "^16.4.6",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "dotenv": "^18.0.10",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "handlebars": "^4.7.10",
    "jose": "^6.2.18",
    "next": "16.4.6",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "^6.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
