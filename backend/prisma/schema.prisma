generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  CASHIER
  WAREHOUSE
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique
  name         String
  passwordHash String
  role         Role            @default(USER)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  phone        String?
  address      String?
  city         String?
  notifyNew    Boolean         @default(false)
  orders       Order[]         @relation("CustomerOrders")
  staffOrders  Order[]         @relation("StaffOrders")
  wishlist     Wishlist[]
  inquiries    Inquiry[]
  stockEntries StockEntry[]
  reviews      Review[]
  returns      ReturnRequest[]
  notifications Notification[]
  pushTokens    PushToken[]
}

enum OrderStatus {
  RESERVED
  EXPIRED
  PENDING_PAYMENT
  CONFIRMED
  PACKING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  TRANSFER
  COD
  CASH
  VNPAY
}

enum PaymentStatus {
  UNPAID
  AWAITING_REVIEW
  PAID
  REFUNDED
}

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Product {
  id              String         @id @default(uuid()) @db.Uuid
  sku             String         @unique
  slug            String         @unique
  name            String
  description     String
  conditionDetail String         @default("")
  origin          String         @default("Nhật Bản")
  dimensions      String         @default("")
  material        String         @default("Gốm sứ")
  price           Int
  costPrice       Int            @default(0)
  active          Boolean        @default(true)
  featured        Boolean        @default(false)
  categoryId      String         @db.Uuid
  category        Category       @relation(fields: [categoryId], references: [id])
  images          ProductImage[]
  inventory       Inventory?
  orderItems      OrderItem[]
  stockEntries    StockEntry[]
  wishlist        Wishlist[]
  reviews         Review[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([categoryId, active])
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int     @default(0)
}

model Inventory {
  productId String   @id @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  onHand    Int      @default(0)
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Order {
  requestKey    String?         @unique @db.Uuid
  refundAmount  Int             @default(0)
  id            String          @id @default(uuid()) @db.Uuid
  code          String          @unique
  customerId    String?         @db.Uuid
  customer      User?           @relation("CustomerOrders", fields: [customerId], references: [id])
  createdById   String?         @db.Uuid
  createdBy     User?           @relation("StaffOrders", fields: [createdById], references: [id])
  channel       String          @default("WEBSITE")
  status        OrderStatus     @default(RESERVED)
  paymentMethod PaymentMethod   @default(COD)
  paymentStatus PaymentStatus   @default(UNPAID)
  recipientName String          @default("")
  phone         String          @default("")
  address       String          @default("")
  city          String          @default("")
  pickup        Boolean         @default(false)
  giftWrap      Boolean         @default(false)
  note          String          @default("")
  trackingCode  String          @default("")
  subtotal      Int
  shippingFee   Int             @default(0)
  discount      Int             @default(0)
  total         Int
  voucherCode   String?
  voucher       Voucher?        @relation(fields: [voucherCode], references: [code])
  expiresAt     DateTime?
  submittedAt   DateTime?
  deliveredAt   DateTime?
  paidAt        DateTime?
  items         OrderItem[]
  events        OrderEvent[]
  returns       ReturnRequest[]
  payment       PaymentAttempt?
  emails        EmailDelivery[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status, expiresAt])
  @@index([customerId, createdAt])
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])
  name      String
  sku       String
  image     String
  quantity  Int
  unitPrice Int
}

model OrderEvent {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())
}

model StockEntry {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id])
  actorId   String?  @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id])
  type      String
  quantity  Int
  note      String
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

model Voucher {
  code      String    @id
  amount    Int
  minTotal  Int       @default(0)
  active    Boolean   @default(true)
  expiresAt DateTime?
  maxUses   Int       @default(100)
  used      Int       @default(0)
  orders    Order[]
}

model Wishlist {
  userId    String  @db.Uuid
  productId String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model Inquiry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  phone     String
  email     String   @default("")
  topic     String
  message   String
  imageUrl  String   @default("")
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ReturnRequest {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id])
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  reason    String
  evidence  String
  status    String   @default("REQUESTED")
  restock   Boolean  @default(false)
  refund    Int      @default(0)
  staffNote String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  rating    Int
  content   String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model ShopSettings {
  id           String @id @default("shop")
  address      String @default("")
  phone        String @default("")
  openingHours String @default("")
  bankName     String @default("")
  bankAccount  String @default("")
  bankOwner    String @default("")
}

model PaymentAttempt {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @unique @db.Uuid
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reference       String   @unique
  amount          Int
  status          String   @default("PENDING")
  transactionNo   String?  @unique
  responseCode    String?
  lastError       String?
  lastCheckedAt   DateTime?
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  nextCheckAt     DateTime
  updatedAt       DateTime @updatedAt

  @@index([status, nextCheckAt])
}

model EmailDelivery {
  id            String    @id @default(uuid()) @db.Uuid
  orderId       String    @db.Uuid
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind          String
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lockedUntil   DateTime?
  sentAt        DateTime?
  messageId     String?
  lastError     String?
  createdAt     DateTime  @default(now())

  @@unique([orderId, kind])
  @@index([status, nextAttemptAt])
}

model Notification {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String @db.Uuid
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  scope     String
  title     String
  body      String
  url       String
  readAt    DateTime?
  createdAt DateTime @default(now())
  pushes    PushDelivery[]
  @@index([userId, readAt, createdAt])
}

model PushToken {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String @db.Uuid
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  token     String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pushes    PushDelivery[]
  @@index([userId])
}

model PushDelivery {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String @db.Uuid
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tokenId        String @db.Uuid
  token          PushToken @relation(fields: [tokenId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  status         String @default("PENDING")
  attempts       Int @default(0)
  nextAttemptAt  DateTime @default(now())
  lockedUntil    DateTime?
  lastError      String?
  @@unique([notificationId, tokenId])
  @@index([status, nextAttemptAt])
}
